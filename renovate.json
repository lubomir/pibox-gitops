{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/clusters/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/clusters/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["runner-config\\.yaml$"],
      "matchStrings": [
        "docker://(?<depName>[^:\"\\s]+):(?<currentValue>[^\"\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
